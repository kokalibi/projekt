#!/usr/bin/env node

/**
 * Module dependencies.
 */
require('dotenv').config();

var app = require('../app');
var debug = require('debug')('bor-back-admin:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */
var port = normalizePort(process.env.PORT || '3000'); // A .env-ben 8080-at találtunk [cite: 2]
app.set('port', port);

/**
 * Create HTTP server.
 */
const server = http.createServer(app);

/**
 * Socket.io inicializálása
 */
const { Server } = require("socket.io");
const io = new Server(server, {
  cors: {
    origin: ["http://localhost:5173", "http://localhost:5174"],
    methods: ["GET", "POST"],
    credentials: true
  }
});

/**
 * Socket.io eseménykezelés
 */
io.on("connection", (socket) => {
  console.log("Új kliens csatlakozott:", socket.id);

  // Belépés egy adott felhasználóhoz tartozó privát szobába
  socket.on("join_room", (userId) => {
    socket.join(`room_${userId}`);
    console.log(`Socket ${socket.id} belépett a room_${userId} szobába`);
  });

  socket.on("admin_changed_user", (data) => {
    if (data.oldUserId) {
      io.to(`room_${data.oldUserId}`).emit("force_close_chat");
    }
  });

  socket.on("disconnect", () => {
    console.log("Kliens lecsatlakozott");
  });
});

// Elérhetővé tesszük az io-t a route-ok számára
app.set("io", io);

/**
 * Listen on provided port, on all network interfaces.
 */
server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Segédfüggvények (Port normalizálás, hiba kezelés)
 */
function normalizePort(val) {
  var port = parseInt(val, 10);
  if (isNaN(port)) return val;
  if (port >= 0) return port;
  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') throw error;
  var bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string' ? 'pipe ' + addr : 'port ' + addr.port;
  debug('Listening on ' + bind);
  console.log("Szerver fut a következő porton: " + port); // Ezt fogod látni a terminálban 
}